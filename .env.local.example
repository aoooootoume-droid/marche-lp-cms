# Firebase (Firebase Console > プロジェクトの設定 > 全般 > マイアプリ から取得)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 管理者(店主)が Firebase Authentication に登録するメールアドレス
# /admin ログイン画面から、このアカウントでログインすると編集モードが使えます。

# Google カレンダーの iCal 非公開/公開アドレス (.ics で終わるURL)
# Googleカレンダー > 設定と共有 > カレンダーの統合 > 「秘密のアドレス(iCal形式)」
# 実際の値は Firestore の site/content ドキュメント内 calendarIcsUrl フィールドで管理しますが、
# ローカル検証用の初期値としてここにも置けます。
NEXT_PUBLIC_DEFAULT_ICS_URL=
